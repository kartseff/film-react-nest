# Backend connection to PostgreSQL inside the Docker Compose network.
# Keep credentials in DATABASE_URL in sync with POSTGRES_* values below.
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://film:film_password@database:5432/film
DATABASE_USERNAME=film
DATABASE_PASSWORD=film_password
PORT=3000

# Available logger formats: DEV, JSON, TSKV
LOGGER=JSON

# PostgreSQL container
POSTGRES_USER=film
POSTGRES_PASSWORD=film_password
POSTGRES_DB=film

# pgAdmin container
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_password

# Frontend build arguments
VITE_API_URL=/api/afisha
VITE_CDN_URL=/content/afisha

# GitHub Container Registry owner used by Docker Compose
GHCR_OWNER=kartseff
